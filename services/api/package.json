{
  "name": "@iam-lab/api",
  "version": "1.0.0",
  "description": "TypeScript resource server with shared policy across local JWT and introspection validation modes.",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "format": "biome check --write .",
    "check": "biome check . && tsc --noEmit && vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
